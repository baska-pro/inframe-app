# Required: URL yang akan dibungkus.
VITE_TARGET_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Branding wrapper.
VITE_APP_TITLE=My Web App

# Google Apps Script: otomatis crop area paling atas untuk menyembunyikan info bar.
VITE_AUTO_CROP_GAS_BANNER=true
VITE_GAS_BANNER_HEIGHT=40
# Isi angka ini bila ingin memaksa offset tertentu. Kosong = auto.
VITE_FRAME_OFFSET_TOP=

# Teruskan query wrapper ke URL target. Contoh ?id=123 -> GAS menerima id=123.
VITE_FORWARD_QUERY_PARAMS=true

# Tombol reload/open external kecil di sudut layar.
VITE_SHOW_CONTROLS=false

# Bantuan fallback muncul setelah N detik.
VITE_LOADING_HELP_AFTER=7

# Advanced: izinkan ?url=... mengganti target pada runtime.
# Default OFF untuk mencegah wrapper publik dipakai membungkus domain sembarang.
VITE_ALLOW_URL_OVERRIDE=false
# Wajib diisi jika override diaktifkan. Pisahkan dengan koma.
VITE_ALLOWED_HOSTS=script.google.com,script.googleusercontent.com

# Advanced compatibility. Biarkan false kecuali target benar-benar gagal karena sandbox.
VITE_DISABLE_SANDBOX=false
