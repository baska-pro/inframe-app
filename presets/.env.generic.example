# Situs non-GAS. Server tujuan tetap harus mengizinkan iframe.
VITE_TARGET_URL=https://app.example.com/
VITE_APP_TITLE=My Web App
VITE_AUTO_CROP_GAS_BANNER=false
VITE_GAS_BANNER_HEIGHT=40
VITE_FRAME_OFFSET_TOP=0
VITE_FORWARD_QUERY_PARAMS=true
VITE_SHOW_CONTROLS=false
VITE_LOADING_HELP_AFTER=7
VITE_ALLOW_URL_OVERRIDE=false
VITE_ALLOWED_HOSTS=app.example.com
VITE_DISABLE_SANDBOX=false
